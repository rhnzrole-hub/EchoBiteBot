# Amaldagi token va admin ID ni shu yerga yozing. Namuna faylni .env deb saqlang.
BOT_TOKEN=123456789:PASTE_YOUR_BOT_TOKEN_HERE
ADMIN_ID=123456789
DATA_DIR=data
BOT_API_MODE=local
BOT_API_URL=http://127.0.0.1:8081
# Windows misoli. Bu bot-api server kesh papkasi, echobite/data emas.
LOCAL_FILES_DIR=C:/EchoBiteBot/telegram-api-data
# Rasmiy telegram-bot-api dasturi alohida build qilinadi; ZIP ichida .exe yo‘q.
TELEGRAM_BOT_API_EXE=C:/telegram-bot-api/bin/telegram-bot-api.exe
# my.telegram.org -> API development tools. Bular BOT_TOKEN dan boshqa qiymatlar.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
DOWNLOAD_TIMEOUT_SECONDS=3600
FFMPEG_TIMEOUT_SECONDS=1800
