# @BotFather bergan token. Hech kimga yubormang.
BOT_TOKEN=123456789:PASTE_YOUR_BOT_TOKEN_HERE
# Faqat bitta egasi: Telegram numeric user ID (username emas).
ADMIN_ID=123456789
DATA_DIR=data
# Cloud: 20 MB. 2 GB uchun .env.local.example va LOCAL_API_WINDOWS.md ni ko‘ring.
BOT_API_MODE=cloud
DOWNLOAD_TIMEOUT_SECONDS=3600
FFMPEG_TIMEOUT_SECONDS=1800
